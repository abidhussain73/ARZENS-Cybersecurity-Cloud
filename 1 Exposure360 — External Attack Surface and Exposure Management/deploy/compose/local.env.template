# Copy this file to .env on a developer or deployment host. Values are local fixtures only.
APP_ENV=local
APP_BASE_URL=https://localhost:8443
DATABASE_URL=postgresql+psycopg://exposure360:exposure360_local_only@postgres:5432/exposure360
REDIS_URL=redis://redis:6379/0
OBJECTSTORE_ENDPOINT=http://objectstore:9000
OBJECTSTORE_BUCKET=exposure360
OBJECTSTORE_ACCESS_KEY=minioadmin
OBJECTSTORE_SECRET_KEY=minioadmin-local-only
OIDC_ISSUER_URL=https://localhost:8443/realms/exposure360
OIDC_JWKS_URL=http://identity:8080/realms/exposure360/protocol/openid-connect/certs
OIDC_CLIENT_ID=exposure360-web
OIDC_CLIENT_SECRET=local-development-only
OIDC_AUDIENCE=exposure360-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
LOG_LEVEL=INFO

# Phase 7 gateway defaults are private-first. Do not bind the gateway publicly
# until a real domain resolves to the host and TLS/DNS activation is approved.
GATEWAY_HOST=localhost
PUBLIC_GATEWAY_URL=https://localhost:8443
MANAGED_DASHBOARD_ORIGIN=http://localhost:3000
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_HOST_PORT=8443
GATEWAY_CADDYFILE=Caddyfile
ACME_EMAIL=
